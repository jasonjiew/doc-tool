# --- 生产输出与用户项目数据（不得进入源码仓库） ---
output/
projects/
logs/
*.log

# --- 原始/未净化 DOCX：仅允许净化模板与测试夹具中的 docx ---
# 模板与测试夹具在白名单中显式登记，其余 docx 一律忽略
*.docx
!templates/*.docx
!doc_tool/resources/templates/*.docx
!scripts/tests/fixtures/**/*.docx

# --- Python 构建产物 ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- PyInstaller / 安装器构建产物 ---
build/
dist/
*.spec.bak

# --- 虚拟环境与本地依赖 ---
.venv/
venv/
env/
.vendor/

# --- 密钥与本地配置 ---
.env
.env.local
*.pem
*.pfx
*.key
secrets.yaml
# 代码签名证书产物（自签名测试证书/私钥备份，禁止入库）
scripts/cert-out/
*.cer

# --- 历史二进制 BAT（含 NUL 字节，仅作留存，禁止作为入口） ---
migration/legacy/binary-bat/*.bat

# --- 编辑器与系统文件 ---
.vscode/
.idea/
.learnings/

# --- 协作/头脑风暴会话产物（可视化伴侣等） ---
.superpowers/
*.swp
*.swo
*~
Thumbs.db
desktop.ini

# --- 诊断临时输出 ---
*.diag.xml
*.diag.txt
probe-*.py
probe-*/

# --- 首页视觉稿比对截图（scripts/tests/shot_home.py 产物，不入库） ---
/home_draft_*.png
/home_final_*.png

# --- 测试产物与本地会话数据 ---
test-results.xml
.coverage
coverage.xml
coverage.json
tmp/
.claude/memories/

# mermaid-cli 本地安装（免管理员）
tools/mermaid-cli/node_modules/
tmp/npm-cache/

# DeepSeek Harness 本地工具（不属于产品代码）
dsh-patches/
start-dsh-web.cmd
